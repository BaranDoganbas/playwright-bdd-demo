{
  "name": "playwright-bdd-demo",
  "version": "1.0.0",
  "description": "Playwright + playwright-bdd E2E framework: page objects, storage-state auth, multi-project config, Cucumber HTML reporting in CI",
  "private": true,
  "scripts": {
    "test": "npx bddgen && npx playwright test",
    "test:ui": "npx bddgen && npx playwright test --project=setup --project=ui --project=auth",
    "test:api": "npx bddgen && npx playwright test --project=api",
    "test:smoke": "npx bddgen && npx playwright test --grep @smoke",
    "test:regression": "npx bddgen && npx playwright test --grep @regression",
    "report": "npx playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "cucumber",
    "gherkin",
    "e2e",
    "test-automation",
    "typescript"
  ],
  "author": "Baran Doğanbaş",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9",
    "typescript-eslint": "^8.65.0"
  }
}
