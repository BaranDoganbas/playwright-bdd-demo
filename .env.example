# Copy to .env and adjust. Every variable is optional: the defaults below target the
# public demo systems the suite ships against, so a fresh clone runs with no .env at all.
# Real process environment variables always win over this file.
#
# Parsed and validated once in src/config/env.ts; an invalid value aborts the run
# before any test executes, listing every problem it found.

# --- Targets -----------------------------------------------------------------
# UI suite under test (SauceDemo).
BASE_URL=https://www.saucedemo.com
# API suite under test (RESTful Booker).
API_BASE_URL=https://restful-booker.herokuapp.com

# --- Credentials -------------------------------------------------------------
# SauceDemo account used by the setup project to seed storage state.
STANDARD_USER=standard_user
USER_PASSWORD=secret_sauce
# RESTful Booker account used for the token call (write operations need it).
API_USER=admin
API_PASSWORD=password123

# --- Execution ---------------------------------------------------------------
# Engine for the browser projects: chromium, firefox or webkit. CI installs only
# chromium; run `npx playwright install firefox webkit` before changing this.
BROWSER=chromium
# Run browsers headless. Set false to watch a run locally.
HEADLESS=true
# Parallel Playwright workers. Unset = auto locally, 2 in CI.
WORKERS=
# Retries per test. Unset = 0 locally, 2 in CI.
RETRIES=
# Cucumber tag expression to filter scenarios, e.g. "@smoke" or "@ui and not @slow".
# Usually set for you by the test:smoke / test:regression npm scripts.
TAGS=

# --- Tuning ------------------------------------------------------------------
# Per-request timeout for the API suite, in ms. The public sandbox cold-starts.
API_TIMEOUT=30000
# Attempts for the auth-token call only. Assertions are never retried.
API_TOKEN_RETRIES=3
# Where the signed-in session is persisted by the setup project.
STORAGE_STATE=.auth/user.json
