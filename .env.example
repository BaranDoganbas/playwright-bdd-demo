# Copy to .env and adjust. Every variable is optional: the defaults target the public
# demo systems the suite ships against, so a fresh clone runs with no .env at all.
# Real environment variables win over this file.

BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com

STANDARD_USER=standard_user
USER_PASSWORD=secret_sauce
API_USER=admin
API_PASSWORD=password123

# chromium, firefox or webkit. CI installs only chromium; run
# `npx playwright install firefox webkit` before changing this.
BROWSER=chromium
HEADLESS=true

# Unset = auto locally, 2 in CI.
WORKERS=
# Unset = 0 locally, 2 in CI.
RETRIES=
# Tag expression, e.g. "@smoke" or "@ui and not @slow".
TAGS=

# Per-request ceiling in ms. The public sandbox cold-starts.
API_TIMEOUT=30000
# Attempts for the auth-token call only. Assertions are never retried.
API_TOKEN_RETRIES=3
STORAGE_STATE=.auth/user.json
